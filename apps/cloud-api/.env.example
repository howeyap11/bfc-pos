DATABASE_URL="postgresql://user:password@localhost:5432/bfc_cloud"
JWT_SECRET="change-this-to-a-secure-random-string"
PORT=3001

# Optional: for seed (admin@example.com / admin123 if not set)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin123

# Settings > Business Details: proxy store-config to POS so name/address save and appear on receipts
# POS_BACKEND_URL=http://localhost:4000
# STORE_CONFIG_ADMIN_KEY=your-shared-secret
