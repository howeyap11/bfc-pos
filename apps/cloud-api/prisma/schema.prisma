generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CloudAdminRole {
  ADMIN
  MANAGER
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         CloudAdminRole @default(ADMIN)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Single row (id=1): tracks current catalog version for sync
model CatalogVersion {
  id            Int @id @default(1)
  latestVersion Int @default(0)
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subCategories SubCategory[]
  items         MenuItem[]
}

enum DrinkTemp {
  HOT
  ICED
  ANY
}

enum DrinkMode {
  ICED
  HOT
  CONCENTRATED
}

model SubCategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    MenuItem[]

  @@index([categoryId])
}

model MenuItem {
  id             String    @id @default(cuid())
  name           String
  priceCents     Int
  imageUrl       String?
  isActive       Boolean   @default(true)
  hasSizes       Boolean   @default(false)
  deletedAt      DateTime?
  sortOrder      Int       @default(0)
  version        Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  categoryId    String?
  subCategoryId String

  defaultSizeId         String?
  defaultSizeOptionId   String?      // MenuOption.id from "Sizes" group

  supportsShots       Boolean  @default(false)
  defaultShots        Int?
  shotsPerSizeEnabled Boolean  @default(false)  // When true, use per-size includedShots from sizePrices; when false, use defaultShots

  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategory SubCategory   @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  defaultSize MenuItemSize? @relation("MenuItemDefaultSize", fields: [defaultSizeId], references: [id], onDelete: SetNull)
  defaultSizeOption MenuOption? @relation("MenuItemDefaultSizeOption", fields: [defaultSizeOptionId], references: [id], onDelete: SetNull)

  recipeLines           RecipeLine[]
  recipeLinesBySize     RecipeLineSize[]
  optionGroupLinks      MenuItemOptionGroup[]
  addOnLinks            MenuItemAddOn[]
  substituteLinks       MenuItemSubstitute[]
  defaultSubstitute     Substitute?  @relation("MenuItemDefaultSubstitute", fields: [defaultSubstituteId], references: [id], onDelete: SetNull)
  defaultSubstituteId   String?      // legacy; use defaultSubstituteOptionId
  addOnGroupLinks       MenuItemAddOnGroup[]
  substituteGroupLinks  MenuItemSubstituteGroup[]
  defaultSubstituteOption SubstituteOption? @relation("MenuItemDefaultSubstituteOption", fields: [defaultSubstituteOptionId], references: [id], onDelete: SetNull)
  defaultSubstituteOptionId String?
  sizes                 MenuItemSize[]
  drinkSizeConfigs    MenuItemDrinkSizeConfig[]
  drinkModeDefaults   MenuItemDrinkModeDefault[]
  sizePrices          MenuItemSizePrice[]

  @@index([version])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([defaultSizeId])
  @@index([defaultSizeOptionId])
  @@index([defaultSubstituteId])
  @@index([defaultSubstituteOptionId])
}

model AddOn {
  id         String   @id @default(cuid())
  name       String
  priceCents Int      @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipeLines     AddOnRecipeLine[]
  menuItemLinks   MenuItemAddOn[]

  @@index([sortOrder])
}

model AddOnRecipeLine {
  id           String   @id @default(cuid())
  addOnId      String
  ingredientId String
  qtyPerItem   Decimal  @db.Decimal(20, 10)
  unitCode     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addOn      AddOn      @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([addOnId, ingredientId])
  @@index([addOnId])
  @@index([ingredientId])
}

model MenuItemAddOn {
  id      String @id @default(cuid())
  itemId  String
  addOnId String

  item  MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  addOn AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@unique([itemId, addOnId])
  @@index([itemId])
  @@index([addOnId])
}

model Substitute {
  id         String   @id @default(cuid())
  name       String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recipeConsumption SubstituteRecipeConsumption[]
  menuItemLinks     MenuItemSubstitute[]
  asDefaultFor      MenuItem[] @relation("MenuItemDefaultSubstitute")
  prices            SubstitutePrice[]

  @@index([sortOrder])
}

model SubstitutePrice {
  id           String    @id @default(cuid())
  substituteId String
  sizeId       String
  mode         DrinkMode
  priceCents   Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  substitute Substitute @relation(fields: [substituteId], references: [id], onDelete: Cascade)
  size       MenuSize   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([substituteId, sizeId, mode])
  @@index([substituteId])
  @@index([sizeId])
}

// Global recipe consumption matrix: per substitute × size × mode (ingredient + qty + unit)
model SubstituteRecipeConsumption {
  id           String    @id @default(cuid())
  substituteId String
  sizeId       String
  mode         DrinkMode
  ingredientId String
  qtyPerItem   Decimal   @db.Decimal(20, 10)
  unitCode     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  substitute Substitute @relation(fields: [substituteId], references: [id], onDelete: Cascade)
  size       MenuSize   @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([substituteId, sizeId, mode])
  @@index([substituteId])
  @@index([sizeId])
  @@index([ingredientId])
}

model MenuItemSubstitute {
  id           String   @id @default(cuid())
  itemId       String
  substituteId String

  item      MenuItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  substitute Substitute @relation(fields: [substituteId], references: [id], onDelete: Cascade)

  @@unique([itemId, substituteId])
  @@index([itemId])
  @@index([substituteId])
}

// Group-based Add-ons (primary architecture)
model AddOnGroup {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options        AddOnOption[]
  menuItemLinks  MenuItemAddOnGroup[]

  @@index([sortOrder])
}

model AddOnOption {
  id         String   @id @default(cuid())
  groupId    String
  name       String
  priceCents Int      @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group       AddOnGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeLines AddOnOptionRecipeLine[]

  @@index([groupId])
  @@index([sortOrder])
}

model AddOnOptionRecipeLine {
  id           String   @id @default(cuid())
  optionId     String
  ingredientId String
  qtyPerItem   Decimal  @db.Decimal(20, 10)
  unitCode     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  option     AddOnOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredient Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([optionId, ingredientId])
  @@index([optionId])
  @@index([ingredientId])
}

model MenuItemAddOnGroup {
  id      String @id @default(cuid())
  itemId  String
  groupId String

  item  MenuItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([itemId, groupId])
  @@index([itemId])
  @@index([groupId])
}

// Group-based Substitutes (primary architecture)
model SubstituteGroup {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options        SubstituteOption[]
  menuItemLinks  MenuItemSubstituteGroup[]

  @@index([sortOrder])
}

model SubstituteOption {
  id         String   @id @default(cuid())
  groupId    String
  name       String
  priceCents Int      @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group       SubstituteGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeLines SubstituteOptionRecipeLine[]
  asDefaultFor MenuItem[] @relation("MenuItemDefaultSubstituteOption")

  @@index([groupId])
  @@index([sortOrder])
}

model SubstituteOptionRecipeLine {
  id           String   @id @default(cuid())
  optionId     String
  ingredientId String
  qtyPerItem   Decimal  @db.Decimal(20, 10)
  unitCode     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  option     SubstituteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredient Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([optionId, ingredientId])
  @@index([optionId])
  @@index([ingredientId])
}

model MenuItemSubstituteGroup {
  id      String @id @default(cuid())
  itemId  String
  groupId String

  item  MenuItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group SubstituteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([itemId, groupId])
  @@index([itemId])
  @@index([groupId])
}

model MenuItemSize {
  id         String    @id @default(cuid())
  menuItemId String
  label      String
  temp       DrinkTemp @default(ANY)
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  asDefault MenuItem[] @relation("MenuItemDefaultSize")

  @@index([menuItemId])
  @@unique([menuItemId, label, temp])
}

model MenuItemDrinkSizeConfig {
  id         String    @id @default(cuid())
  menuItemId String
  mode       DrinkMode
  optionId   String
  isEnabled  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  menuItem MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  option   MenuOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, mode, optionId])
  @@index([menuItemId])
  @@index([optionId])
}

model MenuItemDrinkModeDefault {
  id               String    @id @default(cuid())
  menuItemId       String
  mode             DrinkMode
  defaultOptionId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  menuItem MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  option   MenuOption @relation(fields: [defaultOptionId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, mode])
  @@index([menuItemId])
  @@index([defaultOptionId])
}

model MenuItemSizePrice {
  id             String    @id @default(cuid())
  menuItemId     String
  baseType       DrinkMode
  sizeOptionId   String
  sizeCode       String
  priceCents     Int
  includedShots  Int?      // Free shots for this size+temp; null = use MenuItem.defaultShots
  createdAt      DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  menuItem MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  option   MenuOption @relation(fields: [sizeOptionId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, baseType, sizeOptionId])
  @@index([menuItemId])
  @@index([sizeOptionId])
}

model MenuOptionGroup {
  id               String       @id @default(cuid())
  name             String
  required         Boolean      @default(false)
  multi            Boolean      @default(false)
  defaultOptionId  String?

  isSizeGroup           Boolean @default(false)
  isSystem              Boolean @default(false)
  isDeletable           Boolean @default(true)
  trackRecipeConsumption Boolean @default(false)

  items          MenuItemOptionGroup[]
  options        MenuOption[]
  sections       MenuOptionGroupSection[]
  defaultOption  MenuOption?   @relation("GroupDefaultOption", fields: [defaultOptionId], references: [id], onDelete: SetNull)

  @@index([defaultOptionId])
}

model MenuOptionGroupSection {
  id            String  @id @default(cuid())
  optionGroupId String
  key           String
  label         String
  sortOrder     Int     @default(0)
  isSystem      Boolean @default(false)
  isDeletable   Boolean @default(true)

  optionGroup MenuOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([optionGroupId, key])
  @@index([optionGroupId])
}

model MenuOption {
  id         String @id @default(cuid())
  name       String
  priceDelta Int    @default(0)
  sortOrder  Int    @default(0)

  groupId String
  group   MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  asDefaultSize           MenuItem[]          @relation("MenuItemDefaultSizeOption")
  drinkSizeConfigs        MenuItemDrinkSizeConfig[]
  drinkModeDefaults       MenuItemDrinkModeDefault[]
  sizePrices              MenuItemSizePrice[]
  asDefaultForGroups      MenuOptionGroup[]   @relation("GroupDefaultOption")
  recipeLines             OptionChoiceRecipeLine[]

  @@index([groupId])
}

model OptionChoiceRecipeLine {
  id           String   @id @default(cuid())
  optionId     String
  ingredientId String
  qtyPerItem   Decimal  @db.Decimal(20, 10)
  unitCode     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  option     MenuOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredient Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([optionId, ingredientId])
  @@index([optionId])
  @@index([ingredientId])
}

model MenuItemOptionGroup {
  id      String @id @default(cuid())
  itemId  String
  groupId String

  item  MenuItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([itemId, groupId])
  @@index([itemId])
  @@index([groupId])
}

model ShotPricingRule {
  id                 String   @id @default(cuid())
  name               String   @default("Standard")
  shotsPerBundle     Int      @default(2)
  priceCentsPerBundle Int     @default(4000)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  /** Extra-shot inventory: ingredient deducted per shot above included count (optional). */
  extraShotIngredientId String?
  qtyPerExtraShot       Decimal? @db.Decimal(20, 10)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  extraShotIngredient Ingredient? @relation("ShotRuleExtraIngredient", fields: [extraShotIngredientId], references: [id], onDelete: SetNull)

  @@index([extraShotIngredientId])
}

model TransactionTypeSetting {
  id              String   @id @default(cuid())
  code            String   @unique
  label           String
  priceDeltaCents Int      @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Single-row store settings (id=1)
model StoreSetting {
  id                 String   @id @default("1")
  adminPinHash       String?
  ownerPasswordHash  String?  // Owner/developer tools password (bcrypt-style hash)
  /** Daily sales + inventory report recipient (CC). Source of truth for automated report email jobs. */
  reportRecipientEmail      String?
  /** Local time HH:mm (store / Asia–Manila operational day). Default 00:30 = after midnight close. */
  dailySalesEmailTimeLocal    String   @default("00:30")
  /** Work log / staff audit day rollover (HH:mm, 24h). Business date ticks after this local time. */
  workDayFromTimeLocal        String   @default("04:00")
  /** Display / paired end of work window (HH:mm); same as From means next-day same clock. */
  workDayToTimeLocal          String   @default("04:00")
  inventoryEmailEnabled     Boolean  @default(false)
  inventoryReportType       String   @default("Ingredients Input Based")
  /** Fixed service charge percent shown on POS when locked (e.g. 10 = 10%). */
  fixedServiceChargePercent Int      @default(10)
  updatedAt          DateTime @updatedAt
}

// Settings > Business Details: name and address (single row, id=1)
model BusinessDetails {
  id           String   @id @default("1")
  businessName String?
  address      String?
  updatedAt    DateTime @updatedAt
}

// Settings > Receipts: BIR / PTU display fields (single row, id=1). Owner/trade name comes from BusinessDetails.businessName.
model ReceiptDetails {
  id             String   @id @default("1")
  taxType        String   @default("NONVAT Registered")
  receiptMessage String?
  birEnabled     Boolean  @default(true)
  permitNo       String?
  issueDate      String? // Display string e.g. MM/DD/YYYY
  nonVatTin      String?
  vatTin         String?
  birMin         String? // BIR machine identification (MIN)
  birSerialNo    String? // BIR serial (S/N)
  updatedAt      DateTime @updatedAt
}

// Operational team grouping for cloud admin. Future: SOP and schedule assignment may target groupId.
model StaffGroup {
  id          String   @id @default(cuid())
  storeId     String   @default("store_1")
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff Staff[]

  @@unique([storeId, name])
  @@index([storeId])
}

// Staff (POS cashiers/managers): source of truth for names, PINs, email, roles; syncs to POS
model Staff {
  id        String   @id @default(cuid())
  storeId   String   @default("store_1")
  name      String
  email     String?  // Optional; for future staff web login
  passcode  String   @default("") // Deprecated: kept empty when passcodeHash is set; legacy rows may still have digits
  passcodeHash String? // scrypt1$… hashed PIN; source of truth for verification; synced to POS
  role      String   @default("BARISTA") // HEAD_BARISTA | HEAD_CHEF | BARISTA | LEAD_BARISTA | MANAGER | KITCHEN_STAFF | ADMIN
  isActive  Boolean  @default(true)
  groupId   String?
  staffGroup StaffGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
  @@index([groupId])
}

// Synced from POS for Cloud Admin reporting
model SyncedTransaction {
  id                   String    @id @default(cuid())
  storeId              String
  sourceTransactionId  String    @unique // POS transaction id (idempotency)
  transactionNo        Int
  status               String    // PAID | VOID
  source               String    @default("POS") // POS, QR, etc.
  serviceType          String    @default("DINE_IN")
  cashierName          String?
  totalCents           Int
  subtotalCents        Int       @default(0)
  discountCents        Int       @default(0)
  itemsCount           Int       @default(0)
  paymentsJson         String    // JSON array of { method, amountCents }
  lineItemsSummaryJson String?   // JSON array of { name, qty, lineTotal } for display
  createdAt            DateTime
  voidedAt             DateTime?
  voidReason           String?
  isTest               Boolean   @default(false) // Demo/test only; safe to delete via dev tool
  refundAmountCents    Int       @default(0) // Sum of all refunds for reconciliation
  refundsJson          String?   // JSON array of { id, reason, amountCents, createdAt } for audit

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([isTest])
}


// POS devices - one per physical mini PC
model Device {
  id          String   @id @default(cuid())
  storeId     String   @default("store_1")
  name        String   // e.g. "Café POS 1"
  deviceKey   String   @unique // secret for polling auth; owner copies to POS .env
  lastSeenAt  DateTime?
  posVersion  String?  // reported by POS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  commands DeviceCommand[]

  @@index([storeId])
}

enum DeviceCommandType {
  UPDATE_POS
  RESTART_POS
  FORCE_SYNC
}

enum DeviceCommandStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model DeviceCommand {
  id          String            @id @default(cuid())
  deviceId    String
  type        DeviceCommandType
  status      DeviceCommandStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([deviceId, status])
}

// Audit log for dev-mode actions (no production transaction deletion)
model DevActionLog {
  id            String   @id @default(cuid())
  adminId       String
  adminEmail    String
  deviceId      String?
  actionType    String   // e.g. CLEAR_ADMIN_CACHE, RESET_DEVICE_CACHE
  scope         String?  // e.g. "local cache", "device abc"
  affectedCount Int?
  result        String   // SUCCESS | FAILURE
  isProduction   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([createdAt])
}

model IngredientCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients Ingredient[]
}

enum InventoryDepartment {
  BAR
  KITCHEN
  PASTRY
  SHARED
}

enum InventoryTrackingType {
  VOLATILE
  EXACT
  COUNT_ONLY
}

enum InventoryLocationType {
  WAREHOUSE
  STORE
  EVENT
  POPUP
}

enum StockMovementType {
  OPENING
  SALE_DEDUCTION
  PURCHASE_ADD
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  RECONCILIATION_VARIANCE
  MANUAL_ADJUSTMENT
  REVERSAL
}

enum StockTransferStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum InventoryReconciliationStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum WasteReasonCode {
  SPILL
  REMAKE
  EXPIRED
  DAMAGED
  TESTING
  OTHER
}

model InventoryLocation {
  id           String                @id @default(cuid())
  code         String                @unique
  name         String
  locationType InventoryLocationType
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  stockMovements     StockMovement[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  reconciliations    InventoryReconciliation[]

  @@index([locationType])
}

model Ingredient {
  id                    String    @id @default(cuid())
  name                  String
  unitCode              String
  isActive              Boolean   @default(true)
  categoryId            String?
  sortOrder             Int       @default(0)
  imageUrl              String?
  deletedAt             DateTime?
  version               Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Inventory metadata (optional for backward compat)
  department            InventoryDepartment?
  trackingType          InventoryTrackingType? @default(EXACT)
  quickCountUnitName    String?
  quickCountUnitToBase  Decimal?  @db.Decimal(20, 10)
  warehouseUnitName     String?
  warehouseUnitToBase   Decimal?  @db.Decimal(20, 10)

  category              IngredientCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeLines           RecipeLine[]
  recipeLinesSize       RecipeLineSize[]
  optionChoiceRecipeLines   OptionChoiceRecipeLine[]
  addOnRecipeLines          AddOnRecipeLine[]
  substituteRecipeConsumptions SubstituteRecipeConsumption[]
  addOnOptionRecipeLines    AddOnOptionRecipeLine[]
  substituteOptionRecipeLines SubstituteOptionRecipeLine[]
  stockMovements        StockMovement[]
  stockTransferLines      StockTransferLine[]
  reconciliationLines     InventoryReconciliationLine[]
  shotRulesAsExtraIngredient ShotPricingRule[] @relation("ShotRuleExtraIngredient")

  @@index([version])
  @@index([categoryId, sortOrder])
  @@index([categoryId])
  @@index([department])
  @@index([trackingType])
}

model StockMovement {
  id                    String            @id @default(cuid())
  ingredientId          String
  locationId            String
  movementType          StockMovementType
  quantityDeltaBaseUnit Decimal           @db.Decimal(20, 10)
  sourceType            String?
  sourceId              String?
  actorStaffId          String?
  approvedByStaffId     String?
  notes                 String?
  businessDate          DateTime?
  createdAt             DateTime          @default(now())

  ingredient Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  location   InventoryLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([sourceType, sourceId])
  @@index([ingredientId, locationId])
  @@index([locationId])
  @@index([createdAt])
}

model StockTransfer {
  id                 String              @id @default(cuid())
  fromLocationId     String
  toLocationId       String
  submittedByStaffId String?
  approvedByStaffId  String?
  status             StockTransferStatus @default(DRAFT)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  fromLocation InventoryLocation @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation   InventoryLocation @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  lines        StockTransferLine[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
}

model StockTransferLine {
  id              String        @id @default(cuid())
  stockTransferId String
  ingredientId    String
  quantityInput   Decimal       @db.Decimal(20, 10)
  quantityBase    Decimal       @db.Decimal(20, 10)
  notes           String?

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([stockTransferId])
  @@index([ingredientId])
}

model InventoryReconciliation {
  id                String                       @id @default(cuid())
  locationId        String
  businessDate      DateTime
  countedByStaffId  String?
  approvedByStaffId String?
  status            InventoryReconciliationStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  location InventoryLocation             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines    InventoryReconciliationLine[]

  @@unique([locationId, businessDate])
  @@index([locationId])
  @@index([businessDate])
}

model InventoryReconciliationLine {
  id                  String    @id @default(cuid())
  reconciliationId    String
  ingredientId        String
  theoreticalQtyBase  Decimal   @db.Decimal(20, 10)
  actualQtyBase       Decimal   @db.Decimal(20, 10)
  varianceQtyBase     Decimal   @db.Decimal(20, 10)
  varianceReasonCode  String?
  notes               String?

  reconciliation InventoryReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  ingredient      Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, ingredientId])
  @@index([reconciliationId])
  @@index([ingredientId])
}

// Menu Settings: expandable for Sizes, future modifiers, etc.
model MenuSettingGroup {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  isSystem    Boolean @default(false)
  isDeletable Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menuSizes   MenuSize[]
}

model MenuSize {
  id         String   @id @default(cuid())
  groupId    String
  label      String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group                  MenuSettingGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  availability           MenuSizeAvailability[]
  substitutePrices       SubstitutePrice[]
  substituteRecipeConsumptions SubstituteRecipeConsumption[]

  @@index([groupId])
}

model MenuSizeAvailability {
  id        String    @id @default(cuid())
  mode      DrinkMode
  sizeId    String
  imageUrl  String?
  isEnabled Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  size MenuSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([mode, sizeId])
  @@index([mode])
  @@index([sizeId])
}

model RecipeLine {
  id           String   @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyPerItem   Decimal  @db.Decimal(20, 10)
  unitCode     String
  deletedAt    DateTime?
  version      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
  @@index([version])
}

model RecipeLineSize {
  id           String   @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  baseType     DrinkMode
  sizeCode     String
  qtyPerItem   Decimal  @db.Decimal(20, 10)
  unitCode     String
  deletedAt    DateTime?
  version      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([menuItemId, ingredientId, baseType, sizeCode])
  @@index([menuItemId])
  @@index([ingredientId])
  @@index([version])
}

model SyncedStaffAttendance {
  id            String   @id @default(cuid())
  sourceLocalId String
  storeId       String
  staffCloudId  String?
  staffName     String
  staffRole     String
  eventType     String
  happenedAt    DateTime
  selfieUrl     String?
  selfieStorageKey String?
  selfieExpiresAt DateTime?
  selfiePurgedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, sourceLocalId])
  @@index([storeId, happenedAt])
}

model SyncedWasteReport {
  id                   String   @id @default(cuid())
  sourceLocalId        String
  storeId              String
  staffCloudId         String?
  staffName            String
  itemType             String
  inventoryItemCloudId String?
  inventoryItemName    String
  quantity             String
  unit                 String?
  reason               String
  notes                String?
  imageUrl             String?
  imageStorageKey      String?
  happenedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([storeId, sourceLocalId])
  @@index([storeId, happenedAt])
}

model SyncedInventoryCountSession {
  id                      String   @id @default(cuid())
  sourceLocalId           String
  storeId                 String
  submittedByStaffCloudId String?
  submittedByLocalStaffId String?
  submittedByStaffName    String
  source                  String
  notes                   String?
  shiftType               String?
  businessDate            String?
  countedAt               DateTime
  /** JSON map ingredientCloudId -> { storeStock, warehouseStock } at cloud ingest time */
  snapshotJson            String?
  /** Increments when same storeId+businessDate+shiftType is resubmitted */
  revision                Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  lines                   SyncedInventoryCountLine[]

  @@unique([storeId, sourceLocalId])
  @@index([storeId, countedAt])
  @@index([storeId, businessDate])
  @@index([storeId, businessDate, shiftType])
}

model SyncedInventoryCountLine {
  id                      String   @id @default(cuid())
  sessionId               String
  inventoryItemCloudId    String
  inventoryItemName       String
  expectedQuantity        String?
  actualQuantity          String
  varianceQuantity        String?
  unit                    String?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  session                 SyncedInventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model SyncedSopChecklistSubmission {
  id                      String   @id @default(cuid())
  sourceLocalId           String
  storeId                 String
  templateCloudId         String?
  templateName            String
  templateVersion         Int
  shiftType               String
  submittedByStaffCloudId String?
  submittedByStaffName    String
  assignedShiftId         String?
  checklistResultJson     String
  notes                   String?
  submittedAt             DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([storeId, sourceLocalId])
  @@index([storeId, submittedAt])
}

model CloudStaffShiftAssignment {
  id             String   @id @default(cuid())
  storeId        String
  staffCloudId   String
  staffName      String
  role           String
  shiftDate      DateTime
  startTimeText  String
  endTimeText    String
  shiftType      String
  assignedBy     String?
  status         String   @default("ASSIGNED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([storeId, shiftDate])
  @@index([staffCloudId, shiftDate])
}

model CloudStaffIncentiveLedger {
  id               String   @id @default(cuid())
  storeId          String
  staffCloudId     String
  staffName        String
  entryType        String
  reason           String
  amount           String
  referenceType    String?
  referenceCloudId String?
  happenedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storeId, staffCloudId, happenedAt])
}
