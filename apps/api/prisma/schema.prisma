generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id                     String                  @id @default("store_1")
  code                   String                  @unique
  name                   String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  auditLogs              AuditLog[]
  categories             Category[]
  ingredients            Ingredient[]
  ingredientStocks       IngredientStock[]
  ingredientWarehouseStocks IngredientWarehouseStock[]
  inventoryCountSessions InventoryCountSession[]
  inventoryMovements     InventoryMovement[]
  inventoryUnits         InventoryUnit[]
  items                  Item[]
  localOutboxes          LocalOutbox[]
  menuBanners            MenuBanner[]
  menuItemRecipes        MenuItemRecipe[]
  menuItemRecipeSizes    MenuItemRecipeSize[]
  options                Option[]
  optionGroups           OptionGroup[]
  orders                 Order[]
  registerSessions       RegisterSession[]
  sopTemplates           SopTemplate[]
  staff                  Staff[]
  storeConfig            StoreConfig?
  snapResiboVouchers     SnapResiboVoucher[]
  tabs                   Tab[]
  tables                 Table[]
  transactions           Transaction[]
  staffAttendanceEvents  StaffAttendanceEvent[]
  wasteReports           WasteReport[]
  staffInventoryCountSessions StaffInventoryCountSession[]
  sopChecklistSubmissions SopChecklistSubmission[]
  staffShiftLocals       StaffShiftLocal[]
  staffIncentiveLedgerLocals StaffIncentiveLedgerLocal[]
  staffStockMovementLocals StaffStockMovementLocal[]
  zones                  Zone[]
}

model StoreConfig {
  id                      String   @id @default(cuid())
  storeId                 String   @unique @default("store_1")
  enabledPaymentMethods   String   @default("[\"CASH\",\"CARD\",\"GCASH\",\"FOODPANDA\"]")
  splitPaymentEnabled     Boolean  @default(true)
  paymentMethodOrder      String?
  stickerPrintCategoryIds String?  // JSON array of category cloud ids; when set, only lines in these categories print stickers
  /** JSON array of local Category.id values. When empty/null, all orders appear on KDS; when set, only orders with ≥1 line whose Item.categoryId is in the set. */
  kitchenDisplayCategoryIds String?
  businessName            String?  // Receipt header; shown at top of receipt
  address                 String?  // Receipt header; each comma becomes a new line
  /** Synced from cloud ReceiptDetails; used with nonVatTin/vatTin to choose TIN line on receipt. */
  receiptTaxType          String?
  receiptNonVatTin        String?
  receiptVatTin           String?
  receiptBirMin           String?
  receiptBirSerialNo      String?
  /** Local POS: when false, QR order flows are hidden/disabled (offline-first; not overwritten by catalog sync). */
  qrMenuEnabled           Boolean  @default(true)
  devMode                 Boolean  @default(false) // When true, synced transactions are marked isTest (demo cleanup)
  snapResiboEnabled       Boolean  @default(false)
  snapResiboPriceCents    Int?     // Price in centavos for paid SnapResibo QR item
  snapResiboRewardMinimumCents Int? // Order total (centavos) above which one free SnapResibo voucher is issued
  /** JSON: { showPending, showQr, showKitchen, showStaff } for /tablet drawer visibility (local POS). */
  tabletNavJson           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  store                   Store    @relation(fields: [storeId], references: [id])
}

model SnapResiboVoucher {
  id             String    @id @default(cuid())
  storeId        String    @default("store_1")
  voucherId      String    // e.g. VCHR_xxxxx from import or generated
  status         String    @default("AVAILABLE") // AVAILABLE | ISSUED | USED
  source         String?   // IMPORT | PAID_ITEM | REWARD
  transactionId  String?
  receiptNo      Int?      // transactionNo when issued
  createdAt      DateTime  @default(now())
  issuedAt       DateTime?
  usedAt        DateTime?
  store          Store     @relation(fields: [storeId], references: [id])

  @@unique([storeId, voucherId])
  @@index([storeId])
  @@index([storeId, status])
  @@index([transactionId])
}

model Staff {
  id        String   @id @default(cuid())
  storeId   String   @default("store_1")
  cloudId   String?  @unique  // Cloud Admin staff id; set when synced from cloud
  name      String
  email     String?  // Optional; synced from cloud for future web login
  passcode  String   @default("1000") // Legacy plaintext PIN; empty when passcodeHash is used
  passcodeHash String? // scrypt1$… from cloud; preferred for verification (offline)
  key       String?  @unique
  role      String   @default("BARISTA") // HEAD_BARISTA | HEAD_CHEF | BARISTA | LEAD_BARISTA | MANAGER | KITCHEN_STAFF | ADMIN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, name])
}

model Zone {
  id      String  @id @default(cuid())
  storeId String  @default("store_1")
  code    String
  name    String
  tables  Table[]
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([storeId, code])
  @@index([storeId])
}

model Table {
  id             String        @id @default(cuid())
  storeId        String        @default("store_1")
  zoneId         String
  label          String
  publicKey      String        @unique
  isActive       Boolean       @default(true)
  isFunctionRoom Boolean       @default(false)
  orders         Order[]
  tabs           Tab[]
  zone           Zone          @relation(fields: [zoneId], references: [id])
  store          Store         @relation(fields: [storeId], references: [id])
  transactions   Transaction[]

  @@unique([zoneId, label])
  @@index([storeId])
  @@index([zoneId])
}

model Category {
  id       String   @id @default(cuid())
  storeId  String   @default("store_1")
  name     String   @unique
  prepArea PrepArea
  sort     Int      @default(0)
  store    Store    @relation(fields: [storeId], references: [id])
  items    Item[]

  @@index([storeId])
}

model Item {
  id                      String                @id @default(cuid())
  storeId                 String                @default("store_1")
  cloudId                 String?               @unique
  name                    String
  description             String?
  series                  String?
  basePrice               Int                   @default(0)
  isActive                Boolean               @default(true)
  isHidden                Boolean               @default(false)
  sort                    Int                   @default(0)
  foodpandaSurchargeCents Int                   @default(2000)
  defaultMilk             MilkType              @default(FULL_CREAM)
  supportsShots           Boolean               @default(false)
  isEspressoDrink         Boolean               @default(false)
  shotsPricingMode        ShotsPricingMode?
  defaultShots12oz        Int                   @default(0)
  defaultShots16oz        Int                   @default(0)
  shotsDefaultSource      ShotsDefaultSource    @default(MANUAL)
  defaultEspressoShots    Int                   @default(0)
  categoryId              String
  category                Category              @relation(fields: [categoryId], references: [id])
  store                   Store                 @relation(fields: [storeId], references: [id])
  images                  ItemImage[]
  itemOptionGroups        ItemOptionGroup[]
  menuItemRecipes         MenuItemRecipe[]
  menuItemRecipeSizes     MenuItemRecipeSize[]
  orderItems              OrderItem[]
  transactionLineItems    TransactionLineItem[]

  @@unique([categoryId, name])
  @@index([storeId])
  @@index([categoryId])
}

model ItemImage {
  id        String   @id @default(cuid())
  itemId    String
  url       String
  isPrimary Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, isPrimary])
}

model OptionGroup {
  id               String            @id @default(cuid())
  storeId          String            @default("store_1")
  name             String            @unique
  type             OptionGroupType
  minSelect        Int               @default(0)
  maxSelect        Int               @default(1)
  isRequired       Boolean           @default(false)
  sort             Int               @default(0)
  itemOptionGroups ItemOptionGroup[]
  options          Option[]
  store            Store             @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Option {
  id               String            @id @default(cuid())
  storeId          String            @default("store_1")
  groupId          String
  name             String
  priceDelta       Int               @default(0)
  isDefault        Boolean           @default(false)
  sort             Int               @default(0)
  group            OptionGroup       @relation(fields: [groupId], references: [id])
  store            Store             @relation(fields: [storeId], references: [id])
  orderItemOptions OrderItemOption[]

  @@index([groupId])
  @@index([storeId])
}

model ItemOptionGroup {
  itemId  String
  groupId String
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  item    Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, groupId])
}

model Tab {
  id           String        @id @default(cuid())
  storeId      String        @default("store_1")
  type         TabType
  status       TabStatus     @default(OPEN)
  tableId      String
  quotaCents   Int           @default(300000)
  note         String?
  openedAt     DateTime      @default(now())
  closedAt     DateTime?
  orders       Order[]
  table        Table         @relation(fields: [tableId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  transactions Transaction[]

  @@index([storeId, status])
  @@index([tableId, status])
}

model Order {
  id            String        @id @default(cuid())
  storeId       String        @default("store_1")
  orderNo       Int
  status        OrderStatus   @default(PLACED)
  source        OrderSource   @default(QR_UNPAID)
  tableId       String
  tabId         String?
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(UNPAID)
  externalRef   String?
  customerNote  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tab           Tab?          @relation(fields: [tabId], references: [id])
  table         Table         @relation(fields: [tableId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  items         OrderItem[]
  transaction   Transaction?
  voidRequest   VoidRequest?

  @@index([storeId, createdAt])
  @@index([status])
  @@index([source])
  @@index([tabId])
}

model OrderItem {
  id        String            @id @default(cuid())
  orderId   String
  itemId    String
  qty       Int               @default(1)
  unitPrice Int               @default(0)
  lineNote  String?
  item      Item              @relation(fields: [itemId], references: [id])
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  options   OrderItemOption[]

  @@index([orderId])
  @@index([itemId])
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  optionId    String
  priceDelta  Int
  option      Option    @relation(fields: [optionId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([optionId])
}

model VoidRequest {
  id          String            @id @default(cuid())
  orderId     String            @unique
  status      VoidRequestStatus @default(PENDING)
  reason      String
  requestedAt DateTime          @default(now())
  requestedBy String?
  decidedAt   DateTime?
  decidedBy   String?
  managerNote String?
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model MenuBanner {
  id        String    @id @default(cuid())
  storeId   String    @default("store_1")
  title     String
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  isActive  Boolean   @default(true)
  sort      Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([isActive])
  @@index([sort])
}

model RegisterSession {
  id           String                @id @default(cuid())
  storeId      String                @default("store_1")
  status       RegisterSessionStatus @default(OPEN)
  openedAt     DateTime              @default(now())
  openedBy     String?
  openingCash  Int                   @default(0)
  closedAt     DateTime?
  closedBy     String?
  closingCash  Int?
  expectedCash Int?
  varianceCash Int?
  note         String?
  store        Store                 @relation(fields: [storeId], references: [id])
  transactions Transaction[]

  @@index([storeId, status])
  @@index([openedAt])
}

model Transaction {
  id                String                @id @default(cuid())
  storeId           String                @default("store_1")
  transactionNo     Int
  status            TransactionStatus     @default(PAID)
  source            TransactionSource     @default(POS)
  serviceType       ServiceType           @default(DINE_IN)
  registerSessionId String?
  orderId           String?               @unique
  tableId           String?
  tabId             String?
  subtotalCents     Int                   @default(0)
  discountCents     Int                   @default(0)
  serviceCents      Int                   @default(0)
  taxCents          Int                   @default(0)
  totalCents        Int                   @default(0)
  isTest            Boolean               @default(false) // Demo/test; syncs to cloud as isTest, safe to delete there
  createdAt         DateTime              @default(now())
  createdBy         String?
  updatedAt         DateTime              @updatedAt
  prepCompletedAt    DateTime?             // When kitchen/bar marked order done (prep time = prepCompletedAt - createdAt)
  prepStartedAt      DateTime?             // KDS: first bump (new → preparing)
  prepReadyAt        DateTime?             // KDS: second bump (preparing → ready)
  voidedAt          DateTime?
  voidedBy          String?
  voidReason        String?
  tab               Tab?                  @relation(fields: [tabId], references: [id])
  table             Table?                @relation(fields: [tableId], references: [id])
  order             Order?                @relation(fields: [orderId], references: [id])
  registerSession   RegisterSession?      @relation(fields: [registerSessionId], references: [id])
  store             Store                 @relation(fields: [storeId], references: [id])
  lineItems         TransactionLineItem[]
  payments          TransactionPayment[]
  refunds           TransactionRefund[]

  @@unique([storeId, transactionNo])
  @@index([storeId, createdAt])
  @@index([registerSessionId])
  @@index([orderId])
  @@index([tableId])
  @@index([tabId])
}

model TransactionLineItem {
  id                   String                  @id @default(cuid())
  transactionId        String
  itemId               String?
  name                 String
  qty                  Int                     @default(1)
  unitPrice            Int                     @default(0)
  modifiersCents       Int                     @default(0)
  lineTotal            Int                     @default(0)
  note                 String?                 // General / discount audit note (e.g. PWD ref)
  specialInstructions  String?                 // Item prep only, for sticker (quoted below ice)
  customerName         String?                 // Per-item name for cup/sticker (left of temp/size)
  isDrink              Boolean?
  serveVessel         String?
  optionsJson          String?
  /// JSON map ingredientCloudId -> qty consumed per 1 unit of this line (frozen at finalize for cloud sync)
  consumptionPerUnitByIngredientJson String?
  categoryName         String?                 // Snapshot at sell time for receipt/display (e.g. "BFC MENU")
  subCategoryName      String?                 // Snapshot at sell time for receipt/display (e.g. "BREWED")
  item                 Item?                   @relation(fields: [itemId], references: [id])
  transaction          Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  refundItems          TransactionRefundItem[]

  @@index([transactionId])
  @@index([itemId])
}

model TransactionPayment {
  id            String                   @id @default(cuid())
  transactionId String
  method        PaymentMethod
  status        TransactionPaymentStatus @default(PAID)
  amountCents   Int
  refNo         String?
  receivedAt    DateTime                 @default(now())
  receivedBy    String?
  transaction   Transaction              @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([method])
}

model TransactionRefund {
  id                String                  @id @default(cuid())
  transactionId     String
  refundedByStaffId String?
  reason            String
  createdAt         DateTime                @default(now())
  transaction       Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  refundItems       TransactionRefundItem[]

  @@index([transactionId])
}

model TransactionRefundItem {
  id                    String              @id @default(cuid())
  refundId              String
  transactionLineItemId String
  qtyRefunded           Int
  amountRefundedCents   Int
  transactionLineItem   TransactionLineItem @relation(fields: [transactionLineItemId], references: [id], onDelete: Cascade)
  refund                TransactionRefund   @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([transactionLineItemId])
}

model AuditLog {
  id        String      @id @default(cuid())
  storeId   String      @default("store_1")
  action    AuditAction
  entity    String?
  entityId  String?
  actorId   String?
  note      String?
  metaJson  String?
  createdAt DateTime    @default(now())
  store     Store       @relation(fields: [storeId], references: [id])

  @@index([storeId, createdAt])
  @@index([entity, entityId])
}

model SopTemplate {
  id          String          @id @default(cuid())
  storeId     String          @default("store_1")
  name        String
  isActive    Boolean         @default(true)
  sort        Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  completions SopCompletion[]
  tasks       SopTask[]
  store       Store           @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, isActive])
}

model SopTask {
  id            String          @id @default(cuid())
  templateId    String
  title         String
  requiresPhoto Boolean         @default(false)
  sort          Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completions   SopCompletion[]
  template      SopTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([templateId, sort])
}

model SopCompletion {
  id          String      @id @default(cuid())
  templateId  String
  taskId      String
  completedAt DateTime    @default(now())
  completedBy String?
  note        String?
  photoPath   String?
  task        SopTask     @relation(fields: [taskId], references: [id])
  template    SopTemplate @relation(fields: [templateId], references: [id])

  @@index([templateId, completedAt])
  @@index([taskId, completedAt])
  @@index([completedAt])
}

model InventoryUnit {
  id                  String               @id @default(cuid())
  storeId             String               @default("store_1")
  code                String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  ingredients         Ingredient[]
  inventoryCountLines InventoryCountLine[]
  inventoryMovements  InventoryMovement[]
  store               Store                @relation(fields: [storeId], references: [id])
  menuItemRecipes     MenuItemRecipe[]
  menuItemRecipeSizes MenuItemRecipeSize[]

  @@unique([storeId, code])
  @@index([storeId])
}

model Ingredient {
  id                       String                  @id @default(cuid())
  storeId                  String                  @default("store_1")
  sku                      String?
  name                     String
  unitId                   String
  reorderLevel             String?
  isActive                 Boolean                 @default(true)
  /// Matches CloudIngredient.cloudId for POS recipe consumption + staff stock actions
  cloudIngredientCloudId   String?                 @unique
  hasSealedUnits           Boolean                 @default(false)
  hasSealedBoxes           Boolean                 @default(false)
  sealedUnitAmount         Int                     @default(0)
  sealedBoxAmount          Int                     @default(0)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  unit                     InventoryUnit           @relation(fields: [unitId], references: [id])
  store                    Store                   @relation(fields: [storeId], references: [id])
  stocks                   IngredientStock?
  warehouseStock           IngredientWarehouseStock?
  inventoryCountLines      InventoryCountLine[]
  inventoryMovements       InventoryMovement[]
  menuItemRecipes          MenuItemRecipe[]
  menuItemRecipeSizes      MenuItemRecipeSize[]

  @@unique([storeId, name])
  @@index([storeId])
  @@index([unitId])
  @@index([isActive])
}

model IngredientStock {
  id           String     @id @default(cuid())
  storeId      String     @default("store_1")
  ingredientId String     @unique
  onHandQty    String     @default("0")
  updatedAt    DateTime   @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  store        Store      @relation(fields: [storeId], references: [id])

  @@unique([storeId, ingredientId])
  @@index([storeId])
}

/// Main cafe / floor stock mirror (WAREHOUSE is IngredientWarehouseStock)
model IngredientWarehouseStock {
  id             String     @id @default(cuid())
  storeId        String     @default("store_1")
  ingredientId   String     @unique
  onHandQty      String     @default("0")
  updatedAt      DateTime   @updatedAt
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  store          Store      @relation(fields: [storeId], references: [id])

  @@unique([storeId, ingredientId])
  @@index([storeId])
}

model MenuItemRecipe {
  id           String        @id @default(cuid())
  storeId      String        @default("store_1")
  menuItemId   String
  ingredientId String
  qtyPerItem   String
  unitId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  unit         InventoryUnit @relation(fields: [unitId], references: [id])
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  item         Item          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  store        Store         @relation(fields: [storeId], references: [id])

  @@unique([storeId, menuItemId, ingredientId])
  @@index([storeId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model MenuItemRecipeSize {
  id           String        @id @default(cuid())
  storeId      String        @default("store_1")
  menuItemId   String
  ingredientId String
  baseType     String
  sizeCode     String
  qtyPerItem   String
  unitId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  unit         InventoryUnit @relation(fields: [unitId], references: [id])
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  item         Item          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  store        Store         @relation(fields: [storeId], references: [id])

  @@unique([storeId, menuItemId, ingredientId, baseType, sizeCode])
  @@index([storeId])
  @@index([menuItemId])
  @@index([ingredientId])
}

model InventoryMovement {
  id               String                @id @default(cuid())
  storeId          String                @default("store_1")
  ingredientId     String
  type             InventoryMovementType
  qtyDelta         String
  unitId           String
  /// STORE = IngredientStock (floor/main cafe); WAREHOUSE = IngredientWarehouseStock. Null treated as STORE for legacy rows.
  locationCode     String?
  /// TRANSACTION_CONSUMPTION | TRANSACTION_REVERSAL | WASTE_REPORT | STORE_ADD | WAREHOUSE_ADD | WH_PULLOUT_TO_STORE
  eventKind        String?
  refType          String?
  refId            String?
  notes            String?
  createdByStaffId String?
  createdAt        DateTime              @default(now())
  unit             InventoryUnit         @relation(fields: [unitId], references: [id])
  ingredient       Ingredient            @relation(fields: [ingredientId], references: [id])
  store            Store                 @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([storeId, ingredientId, createdAt])
  @@index([refType, refId])
  @@index([storeId, locationCode])
}

model InventoryCountSession {
  id                String               @id @default(cuid())
  storeId           String               @default("store_1")
  type              InventoryCountType
  status            InventoryCountStatus @default(DRAFT)
  startedAt         DateTime             @default(now())
  submittedAt       DateTime?
  approvedAt        DateTime?
  createdByStaffId  String?
  approvedByStaffId String?
  lines             InventoryCountLine[]
  store             Store                @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
  @@index([storeId, startedAt])
}

model InventoryCountLine {
  id             String                @id @default(cuid())
  countSessionId String
  ingredientId   String
  countedQty     String
  unitId         String
  notes          String?
  unit           InventoryUnit         @relation(fields: [unitId], references: [id])
  ingredient     Ingredient            @relation(fields: [ingredientId], references: [id])
  countSession   InventoryCountSession @relation(fields: [countSessionId], references: [id], onDelete: Cascade)

  @@unique([countSessionId, ingredientId])
  @@index([countSessionId])
  @@index([ingredientId])
}

model LocalOutbox {
  id          String            @id @default(cuid())
  storeId     String            @default("store_1")
  topic       String
  payloadJson String
  status        LocalOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?
  lastAttemptAt DateTime?         // When the last attempt was made (success or failure)
  createdAt     DateTime          @default(now())
