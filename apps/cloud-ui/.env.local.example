# Cloud API base URL (cloud-api runs on port 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: when Cloud UI talks directly to POS backend (same as STORE_CONFIG_ADMIN_KEY on POS), so Business Details can save
# NEXT_PUBLIC_STORE_CONFIG_ADMIN_KEY=your-shared-secret

# Optional: verify /transactions tab payload in browser after deploy (rebuild UI after changing)
# NEXT_PUBLIC_BFC_TX_DEBUG_INGEST_URL=http://127.0.0.1:7328/ingest/4412edb8-6093-4552-97f7-a28d77cc8a0f
# NEXT_PUBLIC_BFC_TX_DEBUG_SESSION=my-verify-run
